{
  "name": "workexp-video-lessons",
  "version": "1.0.0",
  "private": true,
  "description": "Editorial kinetic-typography copywriting lessons for workexp.org, rendered with Remotion.",
  "license": "UNLICENSED",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "render": "remotion render src/index.ts",
    "render:lesson01": "remotion render src/index.ts Lesson01-AdjectivePurge out/Lesson01-AdjectivePurge.mp4",
    "render:all": "npm run render:lesson01 && npm run render:lesson02",
    "still:lesson01": "remotion still src/index.ts Lesson01-AdjectivePurge out/Lesson01-AdjectivePurge.png --frame=1900",
    "still:character": "remotion still src/index.ts CharacterPreview out/CharacterPreview.png --frame=0 --scale=2",
    "still:scene": "remotion still src/index.ts EditDeskScene out/EditDeskScene.png --frame=0 --scale=2",
    "still:objects": "remotion still src/index.ts ObjectSheet out/ObjectSheet.png --frame=0 --scale=2",
    "render:lesson01-type": "remotion render src/index.ts Lesson01-AdjectivePurge-TypeOnly out/Lesson01-AdjectivePurge-TypeOnly.mp4",
    "render:lesson02": "remotion render src/index.ts Lesson02-SoWhatLadder out/Lesson02-SoWhatLadder.mp4",
    "still:storyboard02": "remotion still src/index.ts Lesson02-Storyboard out/Lesson02-Storyboard.png --frame=0 --scale=2"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "@remotion/fonts": "4.0.545",
    "@remotion/layout-utils": "4.0.545",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
